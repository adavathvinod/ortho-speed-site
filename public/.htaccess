Options -MultiViews
RewriteEngine On

# Force HTTPS + www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.mehetreyhospital\.com$ [NC]
RewriteRule ^ https://www.mehetreyhospital.com%{REQUEST_URI} [L,R=301]

# SPA routing fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
